+     * aqui faria o mesmo alerta mostrar horários diferentes em ambientes diferentes.
+     */
+    private String formatMeasuredAt(HealthReading reading) {
+        if (reading == null || reading.getMeasuredAt() == null) {
+            return NOT_INFORMED;
+        }
