+        LocalDateTime forDoctor = reading.getMeasuredAt()
+                .atOffset(STORAGE_OFFSET)
+                .atZoneSameInstant(DISPLAY_ZONE)
+                .toLocalDateTime();
+
+        return MEASURED_AT_FORMAT.format(forDoctor);
+    }
+}
