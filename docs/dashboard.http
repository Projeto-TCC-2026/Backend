### ===========================================
### DASHBOARD ADMINISTRATIVO - TESTES
### ===========================================

### Variables
@host = http://localhost:8080
@adminEmail = admin@sistema.com
@adminPassword = admin123

### ===========================================
### 1. AUTENTICAÇÃO
### ===========================================

### Login como administrador
POST {{host}}/auth/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
client.test("Admin Login Success", function() {
    client.assert(response.status === 200, "Login should return 200");
    client.global.set("admin_token", response.body.accessToken);
});
%}

### ===========================================
### 2. DASHBOARD PRINCIPAL
### ===========================================

### Dashboard completo (endpoint principal)
GET {{host}}/api/dashboard
Authorization: Bearer {{admin_token}}

> {%
client.test("Dashboard Loaded", function() {
    client.assert(response.status === 200, "Dashboard should load successfully");
    client.assert(response.body.success === true, "Response should be successful");
    
    const data = response.body.data;
    client.assert(typeof data.totalHospitals === 'number', "Should have hospital count");
    client.assert(typeof data.totalDoctors === 'number', "Should have doctor count");
    client.assert(typeof data.totalPatients === 'number', "Should have patient count");
});
%}

### Dashboard do AdminController (endpoint alternativo)
GET {{host}}/api/admin/dashboard
Authorization: Bearer {{admin_token}}

### ===========================================
### 3. MÉTRICAS DETALHADAS
### ===========================================

### Métricas com breakdown detalhado
GET {{host}}/api/dashboard/metrics
Authorization: Bearer {{admin_token}}

> {%
client.test("Detailed Metrics", function() {
    client.assert(response.status === 200, "Metrics should load");
    
    const data = response.body.data;
    client.assert(data.hospitals !== undefined, "Should have hospital metrics");
    client.assert(data.doctors !== undefined, "Should have doctor metrics");
    client.assert(data.patients !== undefined, "Should have patient metrics");
    client.assert(data.users !== undefined, "Should have user metrics");
});
%}

### ===========================================
### 4. ESTATÍSTICAS ESPECÍFICAS
### ===========================================

### Estatísticas de Hospitais
GET {{host}}/api/dashboard/stats/hospitals
Authorization: Bearer {{admin_token}}

> {%
client.test("Hospital Stats", function() {
    client.assert(response.status === 200, "Hospital stats should load");
    
    const data = response.body.data;
    client.assert(typeof data.totalHospitals === 'number', "Should have total hospitals");
    client.assert(typeof data.averageDoctorsPerHospital === 'number', "Should have average calculation");
});
%}

### Estatísticas de Doutores
GET {{host}}/api/dashboard/stats/doctors
Authorization: Bearer {{admin_token}}

> {%
client.test("Doctor Stats", function() {
    client.assert(response.status === 200, "Doctor stats should load");
    
    const data = response.body.data;
    client.assert(typeof data.totalDoctors === 'number', "Should have total doctors");
    client.assert(typeof data.doctorsPerHospital === 'number', "Should have ratio calculation");
});
%}

### Estatísticas de Pacientes
GET {{host}}/api/dashboard/stats/patients
Authorization: Bearer {{admin_token}}

> {%
client.test("Patient Stats", function() {
    client.assert(response.status === 200, "Patient stats should load");
    
    const data = response.body.data;
    client.assert(typeof data.totalPatients === 'number', "Should have total patients");
    client.assert(typeof data.activePatients === 'number', "Should have active patients");
    client.assert(typeof data.inactivePatients === 'number', "Should have inactive patients");
});
%}

### ===========================================
### 5. RESUMO EXECUTIVO
### ===========================================

### Resumo para widgets/cards
GET {{host}}/api/dashboard/summary
Authorization: Bearer {{admin_token}}

> {%
client.test("Executive Summary", function() {
    client.assert(response.status === 200, "Summary should load");
    
    const data = response.body.data;
    client.assert(data.hospitals !== undefined, "Should have hospitals card data");
    client.assert(data.doctors !== undefined, "Should have doctors card data");
    client.assert(data.patients !== undefined, "Should have patients card data");
    client.assert(data.users !== undefined, "Should have users card data");
    
    // Verificar estrutura dos cards
    client.assert(typeof data.hospitals.count === 'number', "Hospital card should have count");
    client.assert(typeof data.hospitals.label === 'string', "Hospital card should have label");
    client.assert(typeof data.hospitals.icon === 'string', "Hospital card should have icon");
    client.assert(typeof data.hospitals.color === 'string', "Hospital card should have color");
});
%}

