### ===========================================
### 13. DOCUMENTAÇÃO E METADATA
### ===========================================

### Verificar metadados nos responses
GET {{host}}/api/dashboard
Authorization: Bearer {{admin_token}}

> {%
client.test("Response Metadata", function() {
    const data = response.body.data;
    
    client.assert(data.lastUpdate !== undefined, "Should have lastUpdate timestamp");
    client.assert(data.systemStatus !== undefined, "Should have system status");
    client.assert(data.message !== undefined, "Should have status message");
});
%}