### ===========================================
### 11. VALIDAÇÃO DOS DADOS
### ===========================================

### Verificar consistência dos números
GET {{host}}/api/admin/dashboard
Authorization: Bearer {{admin_token}}

> {%
client.test("Data Consistency", function() {
    client.assert(response.status === 200, "Should load successfully");
    
    const data = response.body.data;
    
    // Verificar que todos os números são não-negativos
    client.assert(data.totalHospitals >= 0, "Hospitals count should be non-negative");
    client.assert(data.totalDoctors >= 0, "Doctors count should be non-negative");
    client.assert(data.totalPatients >= 0, "Patients count should be non-negative");
    client.assert(data.totalUsers >= 0, "Users count should be non-negative");
    
    // Verificar relações lógicas
    client.assert(data.totalUsers >= data.totalDoctors, "Total users should be >= doctors");
    client.assert(data.totalUsers >= data.totalPatients, "Total users should be >= patients");
});
%}

### Comparar números entre endpoints
GET {{host}}/api/dashboard/metrics
Authorization: Bearer {{admin_token}}

> {%
client.test("Cross-Endpoint Consistency", function() {
    const data = response.body.data;
    
    // Armazenar números para comparação
    client.global.set("metrics_hospitals", data.hospitals.total);
    client.global.set("metrics_doctors", data.doctors.total);
    client.global.set("metrics_patients", data.patients.total);
});
%}

### Verificar consistência com resumo
GET {{host}}/api/dashboard/summary
Authorization: Bearer {{admin_token}}

> {%
client.test("Summary Consistency", function() {
    const data = response.body.data;
    
    // Comparar com números das métricas
    const metricsHospitals = parseInt(client.global.get("metrics_hospitals"));
    const metricsPatients = parseInt(client.global.get("metrics_patients"));
    
    if (metricsHospitals && data.hospitals.count) {
        client.assert(data.hospitals.count === metricsHospitals, 
            "Hospital count should match between metrics and summary");
    }
    
    if (metricsPatients && data.patients.count) {
        client.assert(data.patients.count === metricsPatients,
            "Patient count should match between metrics and summary");
    }
});
%}

